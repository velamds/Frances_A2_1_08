}]}, {"type": "target_word_describer", "contents": [{"content": "Voici des mots que vous utilisez quand vous visitez Londres. ", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "l'Underground", "type": "name"}, {"content": "nom donn\u00e9 au m\u00e9tro de Londres", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : Ici, nous appelons le m\u00e9tro l'Underground. ", "type": "example"}, {"content": "frn4le08ob03aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "le Tube", "type": "name"}, {"content": "une autre mani\u00e8re de nommer le m\u00e9tro de Londres ", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : Le m\u00e9tro est \u00e9galement appel\u00e9 le Tube.", "type": "example"}, {"content": "frn4le08ob03aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "l'implantation ", "type": "name"}, {"content": "action d'installer quelque chose quelque part", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : Son implantation est r\u00e9cente.", "type": "example"}, {"content": "frn4le08ob03aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "devenir", "type": "name"}, {"content": "passer d'un \u00e9tat \u00e0 un autre", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple : Celle-ci devient la rue Belvedere.", "type": "example"}, {"content": "frn4le08ob03aud05", "type": "audio"}]}, {"content": "frn4le08ob03re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Le verbe devenir", "type": "heading"}, {"content": "Le verbe <span class=\"strong\">devenir</span> est un verbe du 3e groupe. ", "type": "describer"}, {"content": "{\"rows\":2,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Forme affirmative\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"con